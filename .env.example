# ==============================================================================
# StackLens AI - Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env containing real API keys to version control.
# .env is explicitly excluded in .gitignore and .dockerignore.
# ==============================================================================

# Nebius Token Factory API Key
# Sign up / obtain from: https://tokenfactory.nebius.com
# Leave empty for offline / deterministic-only diagnostic mode.
NEBIUS_API_KEY=

# Required NVIDIA Model for Nebius x NVIDIA Global AI Hackathon
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Nebius Token Factory OpenAI-compatible API Endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Maximum number of model inference calls allowed per server process run
# (Safeguard to prevent unexpected credit consumption during demonstrations)
STACKLENS_MODEL_CALL_BUDGET=100

# Server Binding Configuration
HOST=127.0.0.1
PORT=8000
